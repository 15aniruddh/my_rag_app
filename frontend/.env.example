# Leave VITE_API_BASE empty for local dev: vite.config.js proxies /api to
# http://127.0.0.1:8000, so requests are same-origin and CORS never applies.
#
# For the deployed site, either:
#   - route /api through CloudFront to the Lambda Function URL (leave empty), or
#   - point straight at the Function URL and set ALLOWED_ORIGINS on the backend.
VITE_API_BASE=
VITE_MODEL_NAME=gemini-3.5-flash-lite

# Only needed if the backend sets APP_ACCESS_KEY. Note this ends up in the
# built JS and is readable by anyone using the site — it deters casual abuse,
# it is not authentication.
VITE_ACCESS_KEY=
